rules_version = '2';

// WriteReady IELTS Firestore rules. The live copy is the one in the Firebase
// console (Firestore > Rules); keep this file in step with it.
//
// The api/ functions use the Admin SDK and skip these rules entirely, so
// anything written only by the server (feedback reports, usage counters,
// maintenance mode) has no client write rule here on purpose.
//
// Rules are OR'd: a request is allowed if ANY match grants it. Nothing below
// can take away what the admin wildcard grants.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Who is asking ─────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    // Staff sign in through /api/staff-login, which mints custom tokens for
    // fixed internal emails. Students sign in with a password or Google, so
    // they can never pass these checks, even with a look-alike email.
    function isStaff() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'custom';
    }

    function staffEmail() {
      return request.auth.token.get('email', '').lower();
    }

    function isAdmin() {
      return isStaff() && staffEmail() == 'admin@writeready.internal';
    }

    function isCenter() {
      return isStaff() && staffEmail().matches('center_[^@]+@writeready[.]internal');
    }

    function isCenterFor(centerId) {
      return isStaff() && staffEmail() == ('center_' + centerId + '@writeready.internal').lower();
    }

    function isTeacher() {
      return isStaff() && staffEmail().matches('teacher_[^@]+@writeready[.]internal');
    }

    function isTeacherFor(teacherId) {
      return isStaff() && staffEmail() == ('teacher_' + teacherId + '@writeready.internal').lower();
    }

    function isStudent() {
      return signedIn() && !isStaff();
    }

    function isSelf(uid) {
      return isStudent() && request.auth.uid == uid;
    }

    // ── Helpers ───────────────────────────────────────────────────────────

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Like and comment counters may only move by one. They may NOT be reset:
    // the client only ever writes current+1 or max(0, current-1), and an
    // allowed reset let any student zero any post's counts from the console.
    function counterStepOk(field) {
      let before = resource.data.get(field, 0);
      let after = request.resource.data.get(field, 0);
      return after is number
        && (after == before || after == before + 1 || after == before - 1);
    }

    function flags() {
      return get(/databases/$(database)/documents/config/featureFlags).data;
    }

    // Same defaults as src/hooks/useFeatureFlag.ts.
    function humanCheckPrice() {
      let price = flags().get('humanCheckPriceUZS', 0);
      return (price is number && price > 0) ? price : 20000;
    }

    function humanCheckFee() {
      let fee = flags().get('humanCheckPlatformFeeUZS', -1);
      return (fee is number && fee >= 0) ? fee : 5000;
    }

    // ── Admin: everything ─────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // ── Users ─────────────────────────────────────────────────────────────

    match /users/{uid} {
      // A center reads every profile because the center portal fetches the
      // whole collection and filters in the browser (CenterAdminPage.tsx).
      // Once that page queries where('centerId','==',<its id>), replace the
      // line below with these two, which stop a center seeing other centers'
      // students and anyone with no center at all:
      //   allow get:  if isSelf(uid) || isCenterFor(resource.data.get('centerId', ''));
      //   allow list: if isSelf(uid) || isCenterFor(resource.data.get('centerId', ''));
      allow read: if isSelf(uid) || isCenter();

      allow create: if
        // A new sign-up always starts on the free plan.
        (isSelf(uid)
          && request.resource.data.keys().hasOnly(['email', 'plan', 'subscriptionExpiresAt', 'createdAt', 'notification'])
          && request.resource.data.plan == 'free'
          && request.resource.data.subscriptionExpiresAt == null)
        // A learning center adds one of its own students.
        || (isCenterFor(request.resource.data.centerId)
          && request.resource.data.keys().hasOnly(['email', 'studentLogin', 'fullName', 'plan', 'subscriptionExpiresAt', 'centerId', 'centerName', 'createdAt', 'bonusAnalyses'])
          && request.resource.data.plan == 'pro'
          && request.resource.data.bonusAnalyses == 0
          && (request.resource.data.subscriptionExpiresAt == null
            || request.resource.data.subscriptionExpiresAt == get(/databases/$(database)/documents/learningCenters/$(request.resource.data.centerId)).data.get('expiresAt', null)));

      allow update: if
        // Students can clear their welcome message, and pay for a Human
        // Check. The balance can only go down; the review itself is checked
        // under humanReviews.
        (isSelf(uid)
          && (changed().hasOnly(['notification'])
            || (changed().hasOnly(['balanceUZS'])
              && request.resource.data.balanceUZS is number
              && request.resource.data.balanceUZS >= 0
              && request.resource.data.balanceUZS < resource.data.get('balanceUZS', 0))))
        // A center renames one of its own students' logins.
        || (isCenterFor(resource.data.get('centerId', '')) && changed().hasOnly(['studentLogin']));
    }

    // ── Writing ───────────────────────────────────────────────────────────

    // Task 1 and Task 2 prompts.
    match /task1_reports/{id} {
      allow read: if signedIn();
    }

    match /task2_reports/{id} {
      allow read: if signedIn();
    }

    // Task 1 charts, one document per prompt, kept apart from the prompt so
    // that loading the prompt list does not drag every chart along with it.
    // signedIn(), not isStudent(): a teacher fetches the chart when building
    // the Word file for a Human Check.
    match /task1_images/{id} {
      allow read: if signedIn();
    }

    match /questions/{id} {
      allow read: if signedIn();
    }

    match /submissions/{id} {
      allow read: if isStudent() && resource.data.uid == request.auth.uid;
      allow create: if isStudent() && request.resource.data.uid == request.auth.uid;
    }

    // AI feedback reports are written by api/feedback.ts only. A center reads
    // the whole collection for its analytics page, same as users above; narrow
    // it the same way once that page filters its query.
    match /feedback_reports/{id} {
      allow read: if (isStudent() && resource.data.uid == request.auth.uid) || isCenter();
    }

    // ── Human Check ───────────────────────────────────────────────────────

    // Students read this list to pick a teacher, so it must stay readable by
    // anyone signed in.
    //
    // WARNING: rules cannot hide a field. While these documents still hold a
    // `login` and plaintext `password` (src/firebase/teachers.ts), ANY student
    // can read every teacher's credentials, sign in at /api/staff-login as
    // that teacher, and reach every Human Check essay. Move those two fields
    // into teacherAuth below. Nothing here can fix it on its own.
    match /teachers/{teacherId} {
      allow read: if signedIn();
    }

    // Teacher credentials. No client rule on purpose: only the admin wildcard
    // above reaches this, and /api/staff-login uses the Admin SDK, which skips
    // rules entirely. Never read this from the browser.
    match /teacherAuth/{teacherId} {
      allow read, write: if false;
    }

    match /humanReviews/{reviewId} {
      allow get: if (isStudent() && resource.data.uid == request.auth.uid)
        || isTeacherFor(resource.data.teacherId);

      // Students query by their own uid; teachers query by their own
      // teacherId (getHumanReviewsForTeacher). Naming the teacher here rather
      // than isTeacher() is what stops one teacher listing the whole
      // collection and reading every student's essay.
      allow list: if (isStudent() && resource.data.uid == request.auth.uid)
        || isTeacherFor(resource.data.get('teacherId', ''));

      // Created in the same transaction that takes the price off the
      // student's balance, at the price and fee the admin set.
      allow create: if isStudent()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'studentName', 'studentEmail', 'teacherId', 'teacherName', 'mode', 'status', 'priceUZS', 'platformFeeUZS', 'requestedAt', 'task1', 'task2'])
        && request.resource.data.status == 'pending'
        && request.resource.data.priceUZS == humanCheckPrice()
        && request.resource.data.platformFeeUZS == humanCheckFee()
        && get(/databases/$(database)/documents/teachers/$(request.resource.data.teacherId)).data.get('active', true) != false
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.balanceUZS
          == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('balanceUZS', 0) - request.resource.data.priceUZS;

      // The assigned teacher uploads the checked essay.
      allow update: if isTeacherFor(resource.data.teacherId)
        && changed().hasOnly(['status', 'feedbackDocBase64', 'feedbackFileName', 'checkedAt'])
        && request.resource.data.status == 'checked';
    }

    // ── Learning centers ──────────────────────────────────────────────────

    match /learningCenters/{centerId} {
      allow get: if isCenterFor(centerId);

      match /students/{studentId} {
        allow read, write: if isCenterFor(centerId);
      }
    }

    // ── Notifications ─────────────────────────────────────────────────────

    match /notifications/{uid}/items/{itemId} {
      allow read: if isSelf(uid);
      allow update: if isSelf(uid) && changed().hasOnly(['read']);

      // A student who just liked a comment tells its author.
      allow create: if isStudent()
        && uid != request.auth.uid
        && request.resource.data.type == 'like'
        && request.resource.data.read == false
        && request.resource.data.keys().hasOnly(['type', 'fromUserName', 'postId', 'postSlug', 'commentId', 'preview', 'read', 'createdAt'])
        && exists(/databases/$(database)/documents/blogPosts/$(request.resource.data.postId)/comments/$(request.resource.data.commentId)/likes/$(request.auth.uid))
        && get(/databases/$(database)/documents/blogPosts/$(request.resource.data.postId)/comments/$(request.resource.data.commentId)).data.userId == uid;

      // A teacher tells the student that their essay has been checked. Same
      // field allowlist as the branch above, so a teacher cannot write
      // arbitrary data into a student's notification.
      allow create: if request.resource.data.type == 'human_feedback'
        && request.resource.data.read == false
        && request.resource.data.keys().hasOnly(['type', 'fromUserName', 'reviewId', 'preview', 'read', 'createdAt'])
        && isTeacherFor(get(/databases/$(database)/documents/humanReviews/$(request.resource.data.reviewId)).data.teacherId)
        && get(/databases/$(database)/documents/humanReviews/$(request.resource.data.reviewId)).data.uid == uid;
    }

    // ── Public content ────────────────────────────────────────────────────

    match /config/featureFlags {
      allow read: if signedIn();
    }

    match /announcements/{id} {
      allow read: if true;
    }

    // The blog is public, but only what has been published. The index and the
    // post page both ask for status == 'published'; the admin panel reads
    // drafts through the wildcard at the top.
    match /blogPosts/{postId} {
      allow read: if resource.data.get('status', '') == 'published';

      allow update: if isStudent()
        && changed().hasOnly(['likeCount', 'commentCount'])
        && counterStepOk('likeCount')
        && counterStepOk('commentCount');

      match /likes/{userId} {
        allow read: if true;
        allow create, delete: if isSelf(userId);
      }

      match /comments/{commentId} {
        allow read: if true;

        allow create: if isStudent()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.likeCount == 0
          && request.resource.data.keys().hasOnly(['userId', 'displayName', 'photoURL', 'text', 'likeCount', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;

        allow update: if isStudent() && changed().hasOnly(['likeCount']) && counterStepOk('likeCount');
        allow delete: if isStudent() && resource.data.userId == request.auth.uid;

        match /likes/{userId} {
          allow read: if true;
          allow create, delete: if isSelf(userId);
        }
      }
    }
  }
}
