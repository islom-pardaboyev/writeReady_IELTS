{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/|@|src/|node_modules/|.*\\.(?:png|jpe?g|gif|svg|ico|webp|txt|xml|html|css|js|json|woff2?)$).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/feedback.ts": {
      "maxDuration": 300
    },
    "api/pre-check.ts": {
      "maxDuration": 30
    },
    "api/check-practice.ts": {
      "maxDuration": 30
    }
  }
}
