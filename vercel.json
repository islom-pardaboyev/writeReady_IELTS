{
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/seen", "destination": "/api/combined?route=seen" },
    { "source": "/api/telegram", "destination": "/api/combined?route=telegram" },
    { "source": "/api/bot-link", "destination": "/api/combined?route=bot-link" },
    { "source": "/api/bot-daily", "destination": "/api/combined?route=bot-daily" },
    { "source": "/api/bot-broadcast", "destination": "/api/combined?route=bot-broadcast" },
    { "source": "/api/email-code", "destination": "/api/combined?route=email-code" },
    { "source": "/api/report-pdf", "destination": "/api/combined?route=report-pdf" },
    { "source": "/api/profile-photo", "destination": "/api/combined?route=profile-photo" },
    { "source": "/api/samples", "destination": "/api/combined?route=samples" },
    { "source": "/api/(.*)", "destination": "/api/$1" },

    { "source": "/", "destination": "/index.html" },
    { "source": "/(auth|dashboard|pricing|account|admin|center-admin|teacher-portal|blog|privacy|terms|faq)", "destination": "/index.html" },
    { "source": "/(feedback|human-review|blog|tg)/([^/]+)", "destination": "/index.html" },
    { "source": "/writing/(mock|practice|relax|quick)", "destination": "/index.html" },
    { "source": "/(v|V)", "destination": "/index.html" },
    { "source": "/(v|V)/([^/]+)", "destination": "/index.html" },
    { "source": "/questions", "destination": "/questions/index.html" },
    { "source": "/questions/:task(task1|task2)/:slug([a-z0-9-]+)", "destination": "/questions/:task/:slug/index.html" },

    { "source": "/((?!api/|@|src/|node_modules/|.*\\.[a-zA-Z0-9]+$).*)", "destination": "/api/not-found" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; base-uri 'self'; form-action 'self'" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' blob: data: https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://api.languagetool.org; frame-src 'self' data: blob: https://writing-database-d0b7c.firebaseapp.com https://accounts.google.com https://apis.google.com; object-src 'self' data: blob:; worker-src 'self' blob:; manifest-src 'self'; base-uri 'self'; form-action 'self'" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/question-images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/(v|V)(/.*)?",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "functions": {
    "api/feedback.ts": {
      "maxDuration": 300
    },
    "api/pre-check.ts": {
      "maxDuration": 30
    },
    "api/check-practice.ts": {
      "maxDuration": 30
    },
    "api/verify.ts": {
      "maxDuration": 15
    },
    "api/combined.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    { "path": "/api/bot-daily", "schedule": "0 1 * * *" },
    { "path": "/api/bot-daily", "schedule": "0 2 * * *" },
    { "path": "/api/bot-daily", "schedule": "0 3 * * *" },
    { "path": "/api/bot-daily", "schedule": "0 4 * * *" },
    { "path": "/api/bot-daily", "schedule": "0 5 * * *" },
    { "path": "/api/bot-daily", "schedule": "0 6 * * *" },
    { "path": "/api/bot-daily", "schedule": "0 7 * * *" },
    { "path": "/api/bot-daily", "schedule": "0 8 * * *" },
    { "path": "/api/bot-daily", "schedule": "0 9 * * *" },
    { "path": "/api/bot-daily", "schedule": "0 10 * * *" },
    { "path": "/api/bot-daily", "schedule": "0 11 * * *" },
    { "path": "/api/bot-daily", "schedule": "0 12 * * *" },
    { "path": "/api/bot-daily", "schedule": "0 13 * * *" },
    { "path": "/api/bot-daily", "schedule": "0 14 * * *" },
    { "path": "/api/bot-daily", "schedule": "0 15 * * *" },
    { "path": "/api/bot-daily", "schedule": "0 16 * * *" },
    { "path": "/api/bot-daily", "schedule": "0 17 * * *" },
    { "path": "/api/bot-daily", "schedule": "0 18 * * *" }
  ]
}
