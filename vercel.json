{
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },

    { "source": "/", "destination": "/index.html" },
    { "source": "/(auth|dashboard|pricing|account|admin|center-admin|teacher-portal|blog|privacy|terms)", "destination": "/index.html" },
    { "source": "/(workspace|feedback|human-review|blog)/([^/]+)", "destination": "/index.html" },
    { "source": "/writing/(mock|practice|relax|quick)", "destination": "/index.html" },

    { "source": "/((?!api/|@|src/|node_modules/|.*\\.[a-zA-Z0-9]+$).*)", "destination": "/api/not-found" }
  ],
  "functions": {
    "api/feedback.ts": {
      "maxDuration": 300
    },
    "api/pre-check.ts": {
      "maxDuration": 30
    },
    "api/check-practice.ts": {
      "maxDuration": 30
    }
  }
}
